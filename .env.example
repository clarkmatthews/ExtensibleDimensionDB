DATABASE_URL="postgresql://dimensionUser:dimensionUser123%21@localhost:5432/dimensionInfo"
# Unique random string, at least 32 characters. The server refuses the old built-in default.
AUTH_SECRET="replace-with-a-long-random-string"
# Used only when the seed creates the administrator for the first time. Not applied on later runs.
# ADMIN_PASSWORD=
# Set to true only when a reverse proxy overwrites X-Forwarded-For with the real client address.
# TRUST_PROXY=false
# Used only until Email Config is saved. Notices are always stored in the app.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Shared secret for the overdue alert route.
# ALERT_SECRET=
# Active user the read-only knowledge MCP signs in as. View grants on that user decide which facts are returned.
# MCP_USER_EMAIL=
# Built-in scheduler for overdue alerts and housekeeping. Set to off when an outside scheduler calls /api/alerts/overdue.
# SCHEDULER=on
# Minutes between overdue checks.
# OVERDUE_CHECK_MINUTES=15
