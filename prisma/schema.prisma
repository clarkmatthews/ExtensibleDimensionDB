generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataType {
  TEXT
  BIG_TEXT
  NUMERIC
  DATE
  TIME
  CHECKBOX
  RADIO
  DROPDOWN
  DATETIME
  ZIPCODE
  ADDRESS
  EMAIL
  PHONE
  COORDINATE
  RECORD_LINK
}

enum ChoiceSource {
  MANUAL
  US_STATE
  US_CITY
}

enum SubjectType {
  DEPARTMENT
  GROUP
  USER
}

enum GrantLevel {
  NONE
  VIEW
  EDIT
}

enum AppModule {
  INBOX
  STORES
  TASK_REPORT
  DEFINITION
  LISTS
  API_CONFIG
  EMAIL_CONFIG
  SITE_CONFIG
  PERMISSIONS
  USERS
  ACCESS
  WORKFLOWS
  NOTICES
  AUDIT
  WEBHOOKS
  IMPORT
  AI_ACCESS
  PROPOSALS
  SSO
}

enum ApiFormat {
  JSON
  XML
}

enum MailSecurity {
  NONE
  STARTTLS
  TLS
}

enum TaskState {
  UNACCEPTED
  ACCEPTED
  COMPLETE
  SKIPPED
  SUSPENDED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskAction {
  ACCEPT
  REJECT
  UPGRADE
  DOWNGRADE
  PERFORM
  WATCH
  UNWATCH
  ASSIGN
  SKIP
  DONE
  POSTPONE
  SUSPEND
  COMMENT
}

enum WorkflowKind {
  NOTIFY
  TASK
}

enum StepFieldRule {
  MUST_HAVE_VALUE
  MUST_CHANGE
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  groups      Group[]
}

model Group {
  id           String      @id @default(cuid())
  name         String
  description  String      @default("")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  members      UserGroup[]
  steps        WorkflowStep[]
  tasks        Task[]
  recipients   WorkflowRecipient[]
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  passwordHash       String
  /// The identity provider's subject for this person, set on their first single sign-on.
  oidcSubject        String?        @unique
  isActive           Boolean        @default(true)
  isAdmin            Boolean        @default(false)
  canDefineWorkflows Boolean        @default(false)
  createdAt          DateTime       @default(now())
  groups             UserGroup[]
  assignedTasks      Task[]         @relation("Assignee")
  originated         StoreProcess[] @relation("Originator")
  events             TaskEvent[]
  watches            TaskWatcher[]
  notifications      Notification[]
  workflowSteps      WorkflowStep[] @relation("WorkflowAssignee")
  fieldChanges       FieldChange[]
  workflowRecipients WorkflowRecipient[]
  sessions           Session[]
  auditEntries       AuditLog[]
  accessTokens       AccessToken[]
  proposals          ChangeProposal[] @relation("Proposer")
  reviews            ChangeProposal[] @relation("Reviewer")
}

/// A personal token that lets an AI assistant use the hosted MCP endpoint as this person.
model AccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// SHA-256 of the token. The token itself is shown once and never stored.
  tokenHash  String    @unique
  /// The first characters of the token, so people can tell their tokens apart.
  prefix     String
  /// "read" always; "propose" lets the assistant submit changes for review.
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  proposals  ChangeProposal[]

  @@index([userId])
}

/// A change an AI assistant proposed. Nothing is saved until a reviewer approves it.
model ChangeProposal {
  id            String      @id @default(cuid())
  recordTypeId  String
  /// The record to change, or null to create a new record.
  locationId    String?
  proposedById  String
  proposedBy    User        @relation("Proposer", fields: [proposedById], references: [id])
  tokenId       String?
  token         AccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  reason        String      @default("")
  /// [{ fieldId, key, name, from, to, input }]: display values before and after, and the form input to save.
  changes       Json
  status        String      @default("PENDING")
  reviewerId    String?
  reviewer      User?       @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewNote    String      @default("")
  reviewedAt    DateTime?
  appliedLocationId String?
  error         String      @default("")
  createdAt     DateTime    @default(now())
  fieldChanges  FieldChange[]

  @@index([status, createdAt])
  @@index([proposedById])
}

/// One signed-in browser. Signing out revokes it; a password change or deactivation revokes all of them.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime @default(now())
  userAgent String    @default("")

  @@index([userId])
}

/// Administrative changes: definitions, lists, people, permissions, workflows, and settings.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model UserGroup {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

/// A kind of record, such as Location, Vendor, or Product. Each type has its own dimensions,
/// attributes, unique identifier, and records.
model RecordType {
  id          String            @id @default(cuid())
  name        String            @unique
  description String            @default("")
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  categories  Category[]
  records     Location[]
  linkFields  FieldDefinition[] @relation("LinkTarget")
}

model Category {
  id          String   @id @default(cuid())
  recordTypeId String
  recordType  RecordType @relation(fields: [recordTypeId], references: [id])
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  fields      FieldDefinition[]
  permissions CategoryPermission[]
  apiScopes   ApiEndpointCategory[]
  processes   WorkflowProcessCategory[]
}

model FieldDefinition {
  id                String    @id @default(cuid())
  key               String    @unique
  friendlyName      String
  description       String    @default("")
  dataType          DataType
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  /// For RECORD_LINK attributes: the record type the link points to.
  linkTypeId        String?
  linkType          RecordType? @relation("LinkTarget", fields: [linkTypeId], references: [id])
  sortOrder         Int       @default(0)
  isActive          Boolean   @default(true)
  isRequired        Boolean   @default(false)
  isStoreKey        Boolean   @default(false)
  isActiveFilter    Boolean   @default(false)
  isCreatedDate     Boolean   @default(false)
  choiceSource      ChoiceSource @default(MANUAL)
  choiceListId      String?
  choiceList        ChoiceList?  @relation(fields: [choiceListId], references: [id], onDelete: SetNull)
  parentFieldId     String?
  parentField       FieldDefinition?  @relation("ListCorrelation", fields: [parentFieldId], references: [id], onDelete: SetNull)
  childLists        FieldDefinition[] @relation("ListCorrelation")
  defaultValue      String    @default("")
  formatExample     String    @default("")
  validationPattern String    @default("")
  useRegex          Boolean   @default(false)
  maxLength         Int?
  minValue          Decimal?  @db.Decimal(18, 4)
  maxValue          Decimal?  @db.Decimal(18, 4)
  negativeOk        Boolean   @default(false)
  decimalOk         Boolean   @default(false)
  numVisible        Int       @default(1)
  multiple          Boolean   @default(false)
  is24Hour          Boolean   @default(true)
  checkboxLabel     String    @default("")
  minDate           String    @default("")
  maxDate           String    @default("")
  createdAt         DateTime  @default(now())
  options           FieldOption[]
  values            FieldValue[]
  permissions       FieldPermission[]
  stepFields        WorkflowStepField[]
  apiFields         ApiEndpointField[]
  changes           FieldChange[]
  triggerFields     WorkflowTriggerField[]
}

model ChoiceList {
  id           String           @id @default(cuid())
  name         String
  description  String           @default("")
  isActive     Boolean          @default(true)
  choiceSource ChoiceSource     @default(MANUAL)
  parentListId String?
  parentList   ChoiceList?      @relation("ListFollows", fields: [parentListId], references: [id], onDelete: SetNull)
  childLists   ChoiceList[]     @relation("ListFollows")
  createdAt    DateTime         @default(now())
  items        ChoiceListItem[]
  fields       FieldDefinition[]
}

model ChoiceListItem {
  id           String     @id @default(cuid())
  listId       String
  list         ChoiceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  label        String
  value        String
  parentValues String     @default("")
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)

  @@index([listId, parentValues])
}

model FieldOption {
  id        String          @id @default(cuid())
  fieldId   String
  field     FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label        String
  value        String
  parentValues String          @default("")
  isDefault    Boolean         @default(false)
  sortOrder    Int             @default(0)
}

model Location {
  id        String         @id @default(cuid())
  recordTypeId String
  recordType RecordType    @relation(fields: [recordTypeId], references: [id])
  /// False when the record is archived. Archived records are hidden from the grid, exports,
  /// the share API, and AI knowledge, and cannot be edited until they are restored.
  isActive  Boolean        @default(true)
  archivedAt   DateTime?
  archivedById String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  values    FieldValue[]
  processes StoreProcess[]
  changes   FieldChange[]
}

model FieldValue {
  id            String          @id @default(cuid())
  locationId    String
  fieldId       String
  location      Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  field         FieldDefinition @relation(fields: [fieldId], references: [id])
  valueText     String?
  valueNumber   Decimal?        @db.Decimal(18, 4)
  valueBoolean  Boolean?
  valueDateTime DateTime?
  updatedAt     DateTime        @updatedAt

  @@unique([locationId, fieldId])
}

model CategoryPermission {
  id                   String      @id @default(cuid())
  categoryId           String
  category             Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subjectType          SubjectType
  subjectId            String
  canAddFields         Boolean     @default(false)
  canRemoveFields      Boolean     @default(false)
  canEditFields        Boolean     @default(false)
  canEditCategory      Boolean     @default(false)
  canAssignPermissions Boolean     @default(false)
  canViewData          Boolean     @default(false)
  grantLevel           GrantLevel  @default(NONE)
  applyToFields        Boolean     @default(false)

  @@unique([categoryId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model FieldPermission {
  id          String          @id @default(cuid())
  fieldId     String
  field       FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  subjectType SubjectType
  subjectId   String
  canView     Boolean         @default(false)
  canUpdate   Boolean         @default(false)

  @@unique([fieldId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model ModulePermission {
  id          String      @id @default(cuid())
  module      AppModule
  subjectType SubjectType
  subjectId   String
  grantLevel  GrantLevel  @default(NONE)

  @@unique([module, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model WorkflowProcess {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  isDefault   Boolean        @default(false)
  isActive    Boolean        @default(true)
  kind        WorkflowKind   @default(TASK)
  onCreate    Boolean        @default(false)
  onChange    Boolean        @default(false)
  manual      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  steps       WorkflowStep[]
  runs        StoreProcess[]
  categories  WorkflowProcessCategory[]
  triggers    WorkflowTriggerField[]
  recipients  WorkflowRecipient[]
}

model WorkflowStep {
  id           String            @id @default(cuid())
  processId    String
  process      WorkflowProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int
  groupId        String
  group          Group             @relation(fields: [groupId], references: [id])
  assigneeUserId String?
  assigneeUser   User?             @relation("WorkflowAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  deadlineDays   Int               @default(1)
  fields       WorkflowStepField[]
  tasks        Task[]
}

model WorkflowStepField {
  stepId  String
  fieldId String
  rule    StepFieldRule   @default(MUST_HAVE_VALUE)
  step    WorkflowStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  field   FieldDefinition @relation(fields: [fieldId], references: [id])

  @@id([stepId, fieldId])
}

model WorkflowProcessCategory {
  processId  String
  categoryId String
  process    WorkflowProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([processId, categoryId])
}

model WorkflowTriggerField {
  processId  String
  fieldId    String
  matchValue String          @default("")
  process    WorkflowProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  field      FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([processId, fieldId])
}

model WorkflowRecipient {
  id        String          @id @default(cuid())
  processId String
  process   WorkflowProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model StoreProcess {
  id           String          @id @default(cuid())
  locationId   String
  location     Location        @relation(fields: [locationId], references: [id])
  processId    String
  process      WorkflowProcess @relation(fields: [processId], references: [id])
  status       String          @default("ACTIVE")
  originatorId String
  originator   User            @relation("Originator", fields: [originatorId], references: [id])
  suspended    Boolean         @default(false)
  /// True when archiving the record suspended this process, so restoring the record resumes it.
  suspendedByArchive Boolean   @default(false)
  createdAt    DateTime        @default(now())
  tasks        Task[]
}

model Task {
  id                String       @id @default(cuid())
  storeProcessId    String
  storeProcess      StoreProcess @relation(fields: [storeProcessId], references: [id], onDelete: Cascade)
  stepId            String
  step              WorkflowStep @relation(fields: [stepId], references: [id])
  locationId        String
  state             TaskState    @default(UNACCEPTED)
  priority          TaskPriority @default(NORMAL)
  assigneeGroupId   String
  assigneeGroup     Group        @relation(fields: [assigneeGroupId], references: [id])
  assigneeUserId    String?
  assigneeUser      User?        @relation("Assignee", fields: [assigneeUserId], references: [id])
  senderUserId      String?
  deadlineAt        DateTime
  fieldChangeId     String?
  fieldChange       FieldChange? @relation(fields: [fieldChangeId], references: [id], onDelete: SetNull)
  acceptedAt        DateTime?
  completedAt       DateTime?
  overdueNotifiedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  events            TaskEvent[]
  watchers          TaskWatcher[]
  notifications     Notification[]

  @@index([state, deadlineAt])
  @@index([locationId])
}

model TaskEvent {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  action    TaskAction
  comment   String     @default("")
  createdAt DateTime   @default(now())
}

model TaskWatcher {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ApiEndpoint {
  id          String                @id @default(uuid())
  name        String
  description String                @default("")
  /// SHA-256 of the secret. The secret itself is shown once, when it is created, and never stored.
  secretHash     String
  /// Last four characters of the secret, so an administrator can tell keys apart.
  secretHint     String    @default("")
  secretOptional Boolean   @default(false)
  format         ApiFormat @default(JSON)
  validFrom   DateTime?             @db.Date
  validTo     DateTime?             @db.Date
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  categories  ApiEndpointCategory[]
  fields      ApiEndpointField[]
  logs        ApiRequestLog[]
}

model ApiEndpointCategory {
  endpointId    String
  categoryId    String
  applyToFields Boolean     @default(false)
  endpoint      ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([endpointId, categoryId])
}

model ApiEndpointField {
  endpointId String
  fieldId    String
  endpoint   ApiEndpoint     @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  field      FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([endpointId, fieldId])
}

model ApiRequestLog {
  id         String      @id @default(cuid())
  endpointId String
  endpoint   ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  sourceIp   String      @default("")
  status     Int
  result     String

  @@index([endpointId, createdAt])
}

model ApiIpBlock {
  /// Endpoint id and caller address, so one caller cannot block other callers or other endpoints.
  key          String    @id
  failureCount Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model LoginLock {
  key          String    @id
  failureCount Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

/// An outside URL that receives signed JSON when records change.
model WebhookEndpoint {
  id          String            @id @default(cuid())
  name        String
  url         String
  /// Signing secret, encrypted with AUTH_SECRET. Shown once when created.
  secret      String
  secretHint  String            @default("")
  /// record.created, record.updated, record.archived, record.restored
  events      String[]
  /// Dimensions whose changes are sent. Empty means every dimension.
  categoryIds String[]
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]
}

/// One event for one endpoint. Retried with growing delays until delivered or failed.
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        String          @default("PENDING")
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastStatus    Int?
  lastError     String          @default("")
  createdAt     DateTime        @default(now())
  deliveredAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// A CSV file uploaded for import, kept between the preview and the confirmation.
model ImportJob {
  id         String    @id @default(cuid())
  userId     String
  fileName   String
  csv        String
  recordTypeId String  @default("")
  status     String    @default("PREVIEWED")
  summary    Json?
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@index([userId, createdAt])
}

/// Background jobs that must run on one server only, and when they last ran.
model JobRun {
  name       String   @id
  lastRunAt  DateTime
  lastResult String   @default("")
}

/// Single sign-on with an OpenID Connect provider (Microsoft Entra ID, Google, Okta, Auth0, and others).
model SsoSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  issuer            String   @default("")
  clientId          String   @default("")
  /// Encrypted with AUTH_SECRET.
  clientSecret      String   @default("")
  buttonLabel       String   @default("Sign in with SSO")
  /// Email domains allowed to sign in, such as example.com. Empty allows any verified email.
  allowedDomains    String[]
  /// Create an account on first sign-in for an allowed email that has none.
  createUsers       Boolean  @default(false)
  /// Group new accounts join, which decides what they can see.
  defaultGroupId    String?
  /// When on, only administrators can still sign in with a password.
  passwordAdminOnly Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("default")
  name      String   @default("Dimension database")
  updatedAt DateTime @updatedAt
}

model MailSettings {
  id                 String       @id @default("default")
  enabled            Boolean      @default(false)
  host               String       @default("")
  port               Int          @default(587)
  security           MailSecurity @default(STARTTLS)
  rejectUnauthorized Boolean      @default(true)
  username           String       @default("")
  password           String       @default("")
  fromName           String       @default("")
  fromEmail          String       @default("")
  replyTo            String       @default("")
  updatedAt          DateTime     @updatedAt
}

model FieldChange {
  id            String         @id @default(cuid())
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fieldId       String
  field         FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  oldValue      String         @default("")
  newValue      String         @default("")
  createdAt     DateTime       @default(now())
  /// Set when the change came from an approved AI proposal.
  proposalId    String?
  proposal      ChangeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  notifications Notification[]
  tasks         Task[]

  @@index([locationId, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([fieldId])
}

model Notification {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  fieldChangeId String?
  fieldChange   FieldChange? @relation(fields: [fieldChangeId], references: [id], onDelete: SetNull)
  message       String
  createdAt     DateTime     @default(now())
  readAt        DateTime?
}
